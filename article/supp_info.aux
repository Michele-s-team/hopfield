\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Performance analysis of the bitwise and classical Ising Metropolis implementations. Subfigure~(\subref  {fig:speedup_curve_ising}) shows the evolution of the speedup factor with the temperature for several sizes of square lattices. (\subref  {fig:normalised_time_ising}) shows the evolution of the normalized spin update time with the temperature, averaged over the different lattice sizes. Finally, (\subref  {fig:sweep_time_vs_N_ising}) presents the evolution of the time taken to perform one sweep depending on the lattice size, for different temperatures.\relax }}{9}{figure.caption.20}\protected@file@percent }
\newlabel{fig:speedup_ising}{{S5}{9}{Performance analysis of the bitwise and classical Ising Metropolis implementations. Subfigure~(\subref {fig:speedup_curve_ising}) shows the evolution of the speedup factor with the temperature for several sizes of square lattices. (\subref {fig:normalised_time_ising}) shows the evolution of the normalized spin update time with the temperature, averaged over the different lattice sizes. Finally, (\subref {fig:sweep_time_vs_N_ising}) presents the evolution of the time taken to perform one sweep depending on the lattice size, for different temperatures.\relax }{figure.caption.20}{}}
\newlabel{fig:speedup_ising@cref}{{[figure][5][]S5}{[1][7][]9}}
