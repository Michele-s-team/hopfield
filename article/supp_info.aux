\@writefile{toc}{\contentsline {subsection}{\numberline {C}Phase diagram}{6}{section*.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Phase diagram of the Ising model for several sizes of square lattices. The network is built with Periodic Boundary Conditions (PBC). The black line corresponds to the exact analytical solution found by Onsager in the case of an infinite square lattice \cite  {Onsager1944}: $m(T)=0$ for $T\geq T_c$ and $m(T)_\pm = \pm \left [ 1 - \sinh ^{-4}(2K) \right ]^{1/8}$ for $T \leq T_c$, with $ K=J/T$ and $ T_c/J=2/\log \left (1+\sqrt  2\right )\approx 2.269$.\relax }}{6}{figure.caption.16}\protected@file@percent }
\newlabel{fig:phase_diagram_ising}{{S2}{6}{Phase diagram of the Ising model for several sizes of square lattices. The network is built with Periodic Boundary Conditions (PBC). The black line corresponds to the exact analytical solution found by Onsager in the case of an infinite square lattice \cite {Onsager1944}: $m(T)=0$ for $T\geq T_c$ and $m(T)_\pm = \pm \left [ 1 - \sinh ^{-4}(2K) \right ]^{1/8}$ for $T \leq T_c$, with $ K=J/T$ and $ T_c/J=2/\log \left (1+\sqrt 2\right )\approx 2.269$.\relax }{figure.caption.16}{}}
\newlabel{fig:phase_diagram_ising@cref}{{[figure][2][]S2}{[1][6][]6}}
\citation{Binder1981}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Trajectories of the 64 magnetizations over time for $L=100$ and $T/J=1.5$. All those trajectories have been obtained from the same simulation. While some realizations quickly collapse into the equilibrium attractors $m_\pm = \pm 0.953$, some require $\sim 10^2$ times more sweeps to reach the same equilibrium.\relax }}{7}{figure.caption.17}\protected@file@percent }
\newlabel{fig:evolution_ising}{{S3}{7}{Trajectories of the 64 magnetizations over time for $L=100$ and $T/J=1.5$. All those trajectories have been obtained from the same simulation. While some realizations quickly collapse into the equilibrium attractors $m_\pm = \pm 0.953$, some require $\sim 10^2$ times more sweeps to reach the same equilibrium.\relax }{figure.caption.17}{}}
\newlabel{fig:evolution_ising@cref}{{[figure][3][]S3}{[1][7][]7}}
