{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "g++ main.cpp src/*.cpp -llapack -lgsl -lgslcblas -lm -O3 -Wno-deprecated -Iinclude -I/usr/include/gsl -Wall -DHAVE_INLINE -o main"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}