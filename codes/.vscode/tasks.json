{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "g++ main.cpp src/*.cpp -llapack -lgsl -lgslcblas -g -O0 -lm -Wno-deprecated -Wno-comment -Iinclude -I/usr/include/gsl -Wall -DHAVE_INLINE -o main"
        //-O3
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}